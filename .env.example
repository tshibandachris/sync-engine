# Copy to .env and fill in. Never commit the real .env.

# --- Node ---
NODE_ENV=development
# PORT=3000

# --- Database (required) ---
# Local compose defaults; replace every password with a long random secret outside throwaway development.
POSTGRES_PASSWORD=postgres
SYNC_APP_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DEVICE_ENROLLMENT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
DEVICE_ADMIN_PASSWORD=REPLACE_WITH_A_THIRD_LONG_RANDOM_SECRET
MAINTENANCE_PASSWORD=REPLACE_WITH_A_FOURTH_LONG_RANDOM_SECRET

# These URLs must contain the same passwords configured above.
DATABASE_URL=postgres://sync_app:REPLACE_WITH_A_LONG_RANDOM_SECRET@db:5432/sync_engine
# Dedicated login inheriting device_enrollment_executor; never a member of sync_app.
DEVICE_ENROLLMENT_DATABASE_URL=postgres://device_enrollment_login:REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET@db:5432/sync_engine
# Dedicated login inheriting device_admin_executor; never a member of sync_app or the enrollment executor.
DEVICE_ADMIN_DATABASE_URL=postgres://device_admin_login:REPLACE_WITH_A_THIRD_LONG_RANDOM_SECRET@db:5432/sync_engine

# Dedicated login inheriting maintenance_purge_executor; used only by the scheduled maintenance runner.
MAINTENANCE_DATABASE_URL=postgres://maintenance_login:REPLACE_WITH_A_FOURTH_LONG_RANDOM_SECRET@db:5432/sync_engine

# --- Local token mint (development only) ---
# JWT_SECRET is development-only and required only when JWKS_URL is empty.
# Never define JWT_SECRET in production; startup refuses it there.
# Generate a local development value with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-32-chars-min
AUTH_ALLOW_DEV_TOKEN=true

# --- Identity provider (required when NODE_ENV=production) ---
# Asymmetric OIDC/Supabase JWKS; ES256 or RS256 only.
JWKS_URL=
JWT_AUDIENCE=authenticated
JWT_ISSUER=
# JWT_SECRET and local shared-secret signing are development-only.
AUTH_ALLOW_SHARED_SECRET=false

# --- S3-compatible object storage (attachments) ---
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observabilité : serveur /metrics sur un port séparé, protégé par bearer token
METRICS_PORT=9464
OPS_METRICS_TOKEN=change-me-generate-with-openssl-rand-hex-32
