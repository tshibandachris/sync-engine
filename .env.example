# Copy to .env and fill in. Never commit the real .env.

# --- Node ---
NODE_ENV=development
# PORT=3000

# --- Database (required) ---
# Local compose defaults; replace every password with a long random secret outside throwaway development.
POSTGRES_PASSWORD=postgres
SYNC_APP_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DEVICE_ENROLLMENT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
DEVICE_ADMIN_PASSWORD=REPLACE_WITH_A_THIRD_LONG_RANDOM_SECRET

# These URLs must contain the same passwords configured above.
DATABASE_URL=postgres://sync_app:REPLACE_WITH_SYNC_APP_PASSWORD@db:5432/sync_engine
# Dedicated login inheriting device_enrollment_executor; never a member of sync_app.
DEVICE_ENROLLMENT_DATABASE_URL=postgres://device_enrollment_login:REPLACE_WITH_DEVICE_ENROLLMENT_PASSWORD@db:5432/sync_engine
# Dedicated login inheriting device_admin_executor; never a member of sync_app or the enrollment executor.
DEVICE_ADMIN_DATABASE_URL=postgres://device_admin_login:REPLACE_WITH_DEVICE_ADMIN_PASSWORD@db:5432/sync_engine

# --- Local token mint (development only) ---
# JWT_SECRET is required when JWKS_URL is empty. The boot guard rejects
# values shorter than 32 chars or equal to the placeholder below.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-32-chars-min
AUTH_ALLOW_DEV_TOKEN=true

# --- Identity provider (required when NODE_ENV=production) ---
# When JWKS_URL is set, tokens are verified against the provider's JWKS.
# The other three are optional; fill them if your provider requires them.
JWKS_URL=
JWT_AUDIENCE=
JWT_ISSUER=
# Claim in which the provider puts the tenant UUID. Defaults to tenantId.
JWT_TENANT_CLAIM=tenantId

# --- S3-compatible object storage (attachments) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observabilité : serveur /metrics sur un port séparé, protégé par bearer token
METRICS_PORT=9464
OPS_METRICS_TOKEN=change-me-generate-with-openssl-rand-hex-32
