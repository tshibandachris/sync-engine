# Copy to .env and fill in. Never commit the real .env.

# --- Node ---
NODE_ENV=development
# PORT=3000

# --- Database (required) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sync_engine

# --- Local token mint (development only) ---
# JWT_SECRET is required when JWKS_URL is empty. The boot guard rejects
# values shorter than 32 chars or equal to the placeholder below.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-32-chars-min
AUTH_ALLOW_DEV_TOKEN=true

# --- Identity provider (required when NODE_ENV=production) ---
# When JWKS_URL is set, tokens are verified against the provider's JWKS.
# The other three are optional; fill them if your provider requires them.
JWKS_URL=
JWT_AUDIENCE=
JWT_ISSUER=
# Claim in which the provider puts the tenant UUID. Defaults to tenantId.
JWT_TENANT_CLAIM=tenantId

# --- S3-compatible object storage (attachments) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
