# Copy to .env.prod and fill in. Never commit .env.prod.
#
# Generate PostgreSQL role passwords with:
#   openssl rand -hex 32
# Use independent values for every role. The maintenance password must be
# hexadecimal so it can be safely interpolated into the Compose connection URL.
# Do not use these PostgreSQL values for JWT signing.

POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_ADMIN_PASSWORD
SYNC_APP_PASSWORD=REPLACE_WITH_SYNC_APP_PASSWORD
DEVICE_ENROLLMENT_PASSWORD=REPLACE_WITH_DEVICE_ENROLLMENT_PASSWORD
DEVICE_ADMIN_PASSWORD=REPLACE_WITH_DEVICE_ADMIN_PASSWORD
MAINTENANCE_PASSWORD=REPLACE_WITH_MAINTENANCE_PASSWORD

# Production authentication: Supabase asymmetric JWKS only.
JWKS_URL=REPLACE_WITH_SUPABASE_JWKS_URL
JWT_ISSUER=REPLACE_WITH_SUPABASE_ISSUER
JWT_AUDIENCE=REPLACE_WITH_SUPABASE_AUDIENCE

OPS_METRICS_TOKEN=REPLACE_WITH_OPS_METRICS_TOKEN

S3_BUCKET=REPLACE_WITH_PRODUCTION_BUCKET
S3_REGION=REPLACE_WITH_S3_REGION
# S3_ENDPOINT= (leave unset for AWS; set the provider endpoint for R2/MinIO)
S3_PUBLIC_ENDPOINT=REPLACE_WITH_PUBLIC_S3_ENDPOINT
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_ACCESS_KEY

# Optional image pin:
# SYNC_ENGINE_IMAGE=ghcr.io/tshibandachris/sync-engine:v1.0.0
