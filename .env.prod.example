# Copy to .env.prod and fill in. Never commit .env.prod.
#
# Generate each secret with:
#   openssl rand -base64 48    (for JWT_SECRET, app passwords)
#   openssl rand -hex 32       (for tokens)

# --- Postgres admin ---
# Used by the db service and by the migrate service. Never used by
# the application: the app connects as sync_app.
POSTGRES_PASSWORD=change-me-openssl-rand-base64-24

# --- Application role ---
# Used by the migrate service to set the password once, and by the
# app and runner to connect.
SYNC_APP_PASSWORD=change-me-openssl-rand-base64-32

# --- API authentication ---
# Only used in dev-secret mode. In production the IdP signs tokens.
# Keep a strong value anyway: it must not be a placeholder.
JWT_SECRET=change-me-openssl-rand-base64-48

# --- Auth mode ---
# Shared-secret mode is set in docker-compose.prod.yml via
# AUTH_ALLOW_SHARED_SECRET=true. No IdP. Tokens are minted offline
# with scripts/mint-token.mjs.

# --- Metrics endpoint ---
OPS_METRICS_TOKEN=change-me-openssl-rand-hex-32

# --- S3-compatible storage ---
S3_BUCKET=sync-engine-attachments
S3_REGION=us-east-1
# S3_ENDPOINT=     (leave empty for AWS; set for MinIO / R2 / etc.)
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# --- Optional ---
# Pin the image tag instead of using the local build:
# SYNC_ENGINE_IMAGE=ghcr.io/tshibandachris/sync-engine:v1.0.0
