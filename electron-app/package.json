{
  "name": "eden-gestion-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Eden Gestion Desktop - Client lourd de caisse hors ligne",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/db/client.cjs && node --check electron/sync/api-client.cjs && node --check electron/sync/outbox.cjs && node --check electron/renderer/renderer.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "12.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.2",
    "electron": "38.2.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "corp.edendevs.edengestion.desktop",
    "productName": "Eden Gestion Desktop",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Eden Gestion Desktop",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Eden Gestion Desktop"
    }
  }
}
